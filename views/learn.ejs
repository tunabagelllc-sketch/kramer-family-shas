<%- include('partials/head', { title: 'Pick what to learn' }) %>
<h1 class="serif">What would you like to learn?</h1>
<p class="muted lead">Choose Gemara or Mishnayos, then a masechta. Take the whole thing, or tap just the parts you want.</p>

<div class="modes" role="group" aria-label="What to learn">
  <% Object.values(tracks).forEach(tr => { const on = tr.key === t.key; %>
    <a class="mode<%= on ? ' on' : '' %>" href="/learn?track=<%= tr.key %>" <%= on ? 'aria-current=page' : '' %>>
      <span class="heb serif" lang="he" dir="rtl"><%= tr.heb %></span>
      <span class="strong"><%= tr.name %></span>
      <span class="small"><%= tr.total.toLocaleString() %> <%= tr.many %></span>
    </a>
  <% }) %>
</div>

<nav class="tabs" aria-label="Sedarim">
  <% t.sedarim.forEach((sd, i) => { %>
    <a class="tab<%= i === s ? ' on' : '' %>" href="/learn?track=<%= t.key %>&s=<%= i %>" <%= i === s ? 'aria-current=page' : '' %>><%= sd.name %> <span lang="he" class="serif"><%= sd.heb %></span></a>
  <% }) %>
</nav>

<div class="split">
  <div class="list">
    <% seder.masechtos.forEach(mx => { const on = mx.key === x.key; const tk = takenCount[mx.key] || 0; %>
      <a class="mas<%= on ? ' on' : '' %>" href="/learn?track=<%= t.key %>&s=<%= s %>&m=<%= mx.key %>#detail" <%= on ? 'aria-current=page' : '' %>>
        <span class="mas-text">
          <span class="strong"><%= mx.name %></span>
          <span class="muted small"><%= mx.count %> <%= t.many %> · <%= tk === 0 ? 'all open' : tk >= mx.count ? 'fully taken' : (mx.count - tk) + ' open' %></span>
        </span>
        <span class="heb serif" lang="he" dir="rtl"><%= mx.heb %></span>
      </a>
    <% }) %>
  </div>

  <section class="card detail" id="detail">
    <div class="detail-head">
      <div>
        <h2 class="serif title"><%= t.key === 'm' ? 'Mishnayos ' : '' %><%= x.name %></h2>
        <span class="muted"><%= x.count %> <%= t.many %> · <%= free %> still open</span>
      </div>
      <span class="heb serif bigheb" lang="he" dir="rtl"><%= x.heb %></span>
    </div>

    <form method="post" action="/claim">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <input type="hidden" name="track" value="<%= t.key %>">
      <input type="hidden" name="masechta" value="<%= x.key %>">
      <div class="options">
        <div class="option primary-opt">
          <span class="eyebrow">Option 1</span>
          <span class="strong lg">The whole masechta</span>
          <span class="muted small"><%= free === x.count ? `All ${x.count} ${t.many} are open. Take it all and make your own siyum.` : free === 0 ? 'Everything here is already taken.' : `Some ${t.many} are taken. You can take the ${free} that are left.` %></span>
          <button class="btn primary" type="submit" name="mode" value="whole" <%= free === 0 ? 'disabled' : '' %>><%= free === x.count ? `Take all ${x.count} ${t.many}` : free === 0 ? 'Fully taken' : `Take the remaining ${free}` %></button>
        </div>
        <div class="option">
          <span class="eyebrow muted">Option 2</span>
          <span class="strong lg">Just a few <%= t.many %></span>
          <span class="muted small">Tap the <%= t.key === 'g' ? 'dafim' : 'perakim' %> below, then press this button. Grey ones are already taken.</span>
          <button class="btn" type="submit" name="mode" value="picked" <%= free === 0 ? 'disabled' : '' %>>Add the ones I tapped</button>
        </div>
      </div>

      <div class="legend">
        <span><i class="sw open"></i>Open</span><span><i class="sw pick"></i>Your pick</span><span><i class="sw mine"></i>Already yours</span><span><i class="sw taken"></i>Taken</span>
      </div>
      <div class="units" dir="rtl">
        <% units.forEach(u => { %>
          <% if (u.owner) { const mine = me && u.owner.person_id === me.id; %>
            <span class="unit <%= mine ? 'mine' : 'taken' %>" title="<%= t.unitWord %> <%= u.n %> · <%= mine ? 'yours' : 'taken by ' + u.owner.name %>"><%= u.label %><span class="sr"> (<%= t.unitWord %> <%= u.n %>, <%= mine ? 'yours' : 'taken by ' + u.owner.name %>)</span></span>
          <% } else { %>
            <label class="unit-pick" title="<%= t.unitWord %> <%= u.n %>"><input type="checkbox" name="units" value="<%= u.n %>"><span><%= u.label %><span class="sr"> (<%= t.unitWord %> <%= u.n %>)</span></span></label>
          <% } %>
        <% }) %>
      </div>
    </form>
  </section>
</div>
<%- include('partials/foot') %>
