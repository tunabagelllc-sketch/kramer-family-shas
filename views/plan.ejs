<%- include('partials/head', { title: 'My learning' }) %>
<h1 class="serif"><%= me.name %>’s learning</h1>

<% if (next) { %>
<section class="next card dark">
  <span class="eyebrow gold">Up next</span>
  <span class="serif next-title"><%= next.g.label %> <%= next.g.t.one %> <span lang="he"><%= next.u.label %></span> (<%= next.u.n %>)</span>
  <span class="small"><%= next.g.whole ? 'Whole masechta' : next.g.range %> · <%= next.g.done %> of <%= next.g.units.length %> <%= next.g.t.many %> learned</span>
  <div class="bar dark-bar"><div style="width: <%= Math.round(100 * next.g.done / next.g.units.length) %>%"></div></div>
  <div class="row">
    <form method="post" action="/learned" class="inline">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <input type="hidden" name="track" value="<%= next.g.t.key %>"><input type="hidden" name="masechta" value="<%= next.g.x.key %>">
      <input type="hidden" name="unit" value="<%= next.u.n %>"><input type="hidden" name="learned" value="1">
      <button class="btn gold-btn" type="submit">Mark as learned</button>
    </form>
    <% if (next.u.url) { %><a class="btn ghost-dark" href="<%= next.u.url %>" target="_blank" rel="noopener">Open on Sefaria</a><% } %>
  </div>
</section>
<% } %>

<% if (!groups.length) { %>
  <section class="card center">
    <p class="lead">You haven’t picked anything yet.</p>
    <a class="btn primary" href="/learn">Pick a masechta or a few blatt</a>
  </section>
<% } %>

<% groups.forEach(g => { const anchor = g.t.key + '-' + g.x.key; %>
<section class="card group" id="<%= anchor %>">
  <div class="detail-head">
    <div>
      <h2 class="serif title-sm"><%= g.label %></h2>
      <span class="muted small"><%= g.whole ? 'Whole masechta' : (g.t.key === 'm' ? 'Perek ' : '') + g.range %> · <%= g.done %> of <%= g.units.length %> learned<%= g.done === g.units.length ? ' · Siyum!' : '' %></span>
    </div>
    <span class="heb serif" lang="he" dir="rtl"><%= g.x.heb %></span>
  </div>
  <div class="bar"><div style="width: <%= Math.round(100 * g.done / g.units.length) %>%"></div></div>
  <div class="units" dir="rtl">
    <% g.units.forEach(u => { %>
      <form method="post" action="/learned" class="inline">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <input type="hidden" name="track" value="<%= g.t.key %>"><input type="hidden" name="masechta" value="<%= g.x.key %>">
        <input type="hidden" name="unit" value="<%= u.n %>"><input type="hidden" name="learned" value="<%= u.learned ? '0' : '1' %>">
        <input type="hidden" name="anchor" value="<%= anchor %>">
        <button type="submit" class="unit-btn<%= u.learned ? ' done' : '' %>" aria-pressed="<%= u.learned %>" title="<%= g.t.unitWord %> <%= u.n %>: <%= u.learned ? 'learned (tap to undo)' : 'tap when learned' %>"><%= u.label %><span class="sr"> (<%= g.t.unitWord %> <%= u.n %><%= u.learned ? ', learned' : '' %>)</span></button>
      </form>
    <% }) %>
  </div>
  <details class="small">
    <summary>Give some back</summary>
    <p class="muted">Changed your mind? Give back the ones you haven’t learned so someone else can take them.</p>
    <form method="post" action="/release" class="inline">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <input type="hidden" name="track" value="<%= g.t.key %>"><input type="hidden" name="masechta" value="<%= g.x.key %>">
      <button class="btn small-btn" type="submit">Give back all unlearned <%= g.t.many %></button>
    </form>
  </details>
</section>
<% }) %>
<%- include('partials/foot') %>
