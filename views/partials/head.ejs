<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title><%= title %> · The <%= familyName %> Family Shas</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@500;700&family=Inter:wght@400;500;600&display=swap">
<link rel="stylesheet" href="/style.css?v=<%= v %>">
</head>
<body>
<header class="top">
  <div class="wrap top-row">
    <a class="brand" href="/">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#D9B66A" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5.5C4 4.7 4.7 4 5.5 4H11v16H5.5c-.8 0-1.5-.7-1.5-1.5z"/><path d="M20 5.5c0-.8-.7-1.5-1.5-1.5H13v16h5.5c.8 0 1.5-.7 1.5-1.5z"/></svg>
      The <%= familyName %> Family Shas
    </a>
    <% if (typeof hideNav === 'undefined' || !hideNav) { %>
    <nav class="nav" aria-label="Main">
      <% if (me) { %>
        <a href="/plan">My learning</a>
        <a href="/learn">Pick more</a>
      <% } %>
      <a href="/board">Siyum board</a>
      <% if (me && me.is_admin) { %><a href="/admin">Admin</a><% } %>
      <% if (me) { %>
        <form method="post" action="/switch" class="inline">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button type="submit" class="chip">Learning as <strong><%= me.name %></strong> · Switch</button>
        </form>
      <% } %>
    </nav>
    <% } %>
  </div>
</header>
<% if (typeof actingAdmin !== 'undefined' && actingAdmin && me) { %>
<div class="acting" role="status">
  <div class="wrap acting-row">
    <span>Admin mode: you’re picking for <strong><%= me.name %></strong>. Anything you take or mark goes on <%= me.name %>’s plan.</span>
    <form method="post" action="/admin/return" class="inline">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <button type="submit" class="btn small-btn">Back to <%= actingAdmin.name %></button>
    </form>
  </div>
</div>
<% } %>
<main class="wrap page">
<% if (flash) { %><div class="flash <%= flash.type %>" role="status"><%= flash.msg %></div><% } %>
