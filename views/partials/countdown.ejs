<% const daysLeft = Math.max(1, siyum.days);
   const g = totals.g, m = totals.m, th = totals.t;
   const pct = (v) => { const x = 100 * v.learned / v.total; return v.learned > 0 && x < 1 ? '<1' : String(Math.round(x)); };
   const ringW = (v) => Math.min(100, 100 * v.learned / v.total).toFixed(2); %>
<section class="cd-hero" aria-labelledby="cd-title">
  <div class="wrap">
    <div class="cd-card">
      <div class="cd-left">
        <span class="eyebrow">Family siyum · Chanukah 5788</span>
        <h2 id="cd-title" class="serif cd-title">Countdown to the siyum</h2>
        <div class="cd-clock" data-target="<%= siyum.iso %>" role="timer" aria-live="off">
          <div><span class="cd-num" data-unit="d"><%= siyum.days %></span><span class="cd-lbl">days</span></div>
          <div><span class="cd-num" data-unit="h">–</span><span class="cd-lbl">hours</span></div>
          <div><span class="cd-num" data-unit="m">–</span><span class="cd-lbl">min</span></div>
          <div><span class="cd-num" data-unit="s">–</span><span class="cd-lbl">sec</span></div>
        </div>
        <p class="cd-pace small"><%= siyum.label.replace(/^Chanukah 5788 · /, '') %> · needs about
          <strong><%= Math.ceil((g.total - g.learned) / daysLeft) %> blatt a day</strong> and
          <strong><%= Math.ceil((m.total - m.learned) / daysLeft * 7) %> perakim a week</strong></p>
      </div>
      <div class="cd-rings">
        <% [['Gemara', g, 'blatt', 'learned'], ['Mishnayos', m, 'perakim', 'learned'], ['Tehillim', th, 'kapitlach', 'said']].filter(r => r[1]).forEach(([name, v, unit, word]) => { %>
        <div class="cd-ring-wrap">
          <div class="cd-ring" style="--p: <%= ringW(v) %>%" role="img" aria-label="<%= name %>: <%= v.learned %> of <%= v.total %> <%= unit %> <%= word %>">
            <div class="cd-ring-in"><span class="cd-ring-pct"><%= pct(v) %>%</span><span class="cd-ring-lbl"><%= word %></span></div>
          </div>
          <span class="strong"><%= name %></span>
          <span class="muted small cd-ring-sub"><%= v.learned.toLocaleString() %> of <%= v.total.toLocaleString() %><%= v.round ? ' · Round ' + v.round : ' ' + unit %></span>
        </div>
        <% }) %>
      </div>
    </div>
  </div>
</section>
<script src="/countdown.js?v=<%= v %>" defer></script>
