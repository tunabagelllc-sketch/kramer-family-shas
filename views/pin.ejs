<%- include('partials/head', { title: 'Enter PIN' }) %>
<section class="card narrow center">
  <span class="avatar t2 big-avatar"><%= person.name.charAt(0) %></span>
  <h1 class="serif">Hi, <%= person.name %></h1>
  <form method="post" action="/pin/<%= person.id %>" class="stack">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label for="pin">Your 4-digit PIN</label>
    <input id="pin" name="pin" type="password" inputmode="numeric" pattern="\d{4}" maxlength="4" autocomplete="off" required autofocus class="big pin">
    <% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>
    <button class="btn primary" type="submit">Go</button>
  </form>
  <p class="small"><a href="/">Not you? Pick another name</a></p>
  <p class="muted small">Forgot your PIN? Ask the family admin to reset it.</p>
</section>
<%- include('partials/foot') %>
